[Unit]
Description=大肥鱼每日巡游（可插拔链路实跑 + 产物归档）
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/dafeiyu/app
Environment=TZ=Asia/Shanghai
# 可选：仅在显式允许真发评论时才需要；本地文件已被 gitignore
EnvironmentFile=-/opt/dafeiyu/secrets/bili.env
ExecStart=/opt/dafeiyu/venv/bin/python run_local.py
StandardOutput=append:/opt/dafeiyu/logs/cruise.log
StandardError=append:/opt/dafeiyu/logs/cruise.log
